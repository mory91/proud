set timeout 10

proc fail {message} {
  puts stderr "\nTERMINAL E2E FAIL: $message"
  catch {send ":qa!\r"}
  exit 1
}

proc wait_for {pattern label} {
  expect {
    -re $pattern {
      return
    }
    timeout {
      fail "timed out waiting for $label"
    }
    eof {
      fail "Neovim exited while waiting for $label"
    }
  }
}

proc command {keys pattern label} {
  send $keys
  wait_for $pattern $label
}

log_user 1
spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && ./scripts/run_proud_test_nvim.sh"
set rows 45
set columns 160
if {[info exists env(PROUD_TERM_ROWS)]} {
  set rows $env(PROUD_TERM_ROWS)
}
if {[info exists env(PROUD_TERM_COLUMNS)]} {
  set columns $env(PROUD_TERM_COLUMNS)
}
stty rows $rows columns $columns

wait_for {pull requests} "PR browser"
wait_for {PR} "PR filter header"
wait_for {retry is:open} "PR filter value"
wait_for {#482[^\r\n]*Add retry backoff} "first pull request"

send "j"
send ":lua dofile(vim.env.PROUD_ROOT..'/tests/terminal/pr_selection_assert.lua')\r"
wait_for {SELECTED_SUBTITLE_OK=true} "second pull request title and complete subtitle after one move"
sleep 0.2
command "\r" {#479 overview} "pull request overview"
command "v\x0c:lua vim.env.PROUD_SIDEBAR_MODE='viewed'; dofile(vim.env.PROUD_ROOT..'/tests/terminal/sidebar_assert.lua')\r" {SIDEBAR_VIEWED_OK=true} "overview viewed state"

command ":Proud demo diff\r\x0c" {#482 compare} "pull request diff page"
command ":lua local s=require('proud.session').current.state.diff; vim.wait(15000,function() return s.status~='loading' and next(s.scene.handles)~=nil end,20); vim.api.nvim_set_current_win(s.scene.window); vim.api.nvim_echo({{'DIFF_READY='..s.status}},false,{})\r" {DIFF_READY=ready} "editable diff loaded"
command "\]f\x0c" {withRetry} "file diff file navigation"
command "\]t\x0c" {#482 compare} "thread navigation refresh"
send {:lua local s=require('proud.session').current.state.diff; local ok=s.thread_cursor==2 and s.threads[2].path=='packages/runner/src/config.ts'; vim.api.nvim_echo({{('THREAD_OK='..tostring(ok))}},false,{})}
send "\r"
wait_for {THREAD_OK=true} "thread cursor moved to config.ts"

command ":Proud demo compare\r\x0c" {Compare[^\r\n]*merge base} "branch compare"
send {:lua local s=require('proud.session').current.state; vim.wait(15000,function() return not s.loading and s.diff.status~='loading' end,20); vim.api.nvim_set_current_win(require('proud.ui').workspace_window(s.workspace,'sidebar')); vim.api.nvim_echo({{'COMPARE_READY='..s.diff.status}},false,{})}
send "\r"
wait_for {COMPARE_READY=ready} "compare loaded"
send "S"
send {:lua local s=require('proud.session').current.state; vim.wait(15000,function() return s.head=='main' and not s.loading and s.diff.status~='loading' end,20); local text=table.concat(vim.api.nvim_buf_get_lines(require('proud.ui').workspace_buffer(s.workspace,'sidebar'),0,-1,false),'\n'); local ok=s.base=='feat/task-retry-backoff' and text:find('head  main',1,true)~=nil; vim.api.nvim_echo({{('SWAP_OK='..tostring(ok))}},false,{})}
send "\r"
wait_for {SWAP_OK=true} "branch swap"

command ":Proud demo help\r\x0c" {Proud help} "help window"
command "q\x0c" {Compare[^\r\n]*merge base} "help close"

command ":lua local names={'ProudBackground','ProudPanel','ProudAccent','ProudAdd','ProudDelete'}; for _,name in ipairs(names) do local h=vim.api.nvim_get_hl(0,{name=name}); print(name..'='..string.format('#%06x',h.bg or 0)) end\r" {ProudBackground=#1c1217} "palette groups"
wait_for {ProudPanel=#2a1b22} "ProudPanel palette"
wait_for {ProudAccent=#f0642b} "ProudAccent palette"
wait_for {ProudAdd=#17382e} "ProudAdd palette"
wait_for {ProudDelete=#442127} "ProudDelete palette"

send "\x0c"
sleep 1
send ":qa!\r"
expect eof
