set timeout 10

proc fail {message} {
  puts stderr "\nTERMINAL FILE DIFF FAIL: $message"
  catch {send ":qa!\r"}
  exit 1
}

proc wait_for {pattern label} {
  expect {
    -re $pattern {
      return
    }
    timeout {
      fail "timed out waiting for $label"
    }
    eof {
      fail "Neovim exited while waiting for $label"
    }
  }
}

log_user 1
spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && ./scripts/run_proud_test_nvim.sh"
stty rows 40 columns 160
wait_for {#482 compare} "pull request diff page"
send {:lua local session=require('proud.session'); local page=session.current and session.current.state; local state=page and page.diff; vim.wait(15000,function() return state and state.status~='loading' and (state.status~='ready' or next(state.scene.handles)~=nil) end,20); local win=state.scene.window; local function open_retry() local done=false; for i,f in ipairs(state.files) do if f.path:find('task/retry.ts',1,true) then require('proud.loader').load('diff_view').show_file(state,i,function() done=true end) end end; vim.wait(5000,function() return done end,20) end; open_retry(); local buf=vim.api.nvim_win_get_buf(win); local lines=vim.api.nvim_buf_get_lines(buf,0,-1,false); local code=table.concat(lines,'\n'); local ns=vim.api.nvim_get_namespaces().proud_inline_diff; local added=false; local deleted=false; for _,m in ipairs(vim.api.nvim_buf_get_extmarks(buf,ns,0,-1,{details=true})) do local d=m[4]; if d.line_hl_group=='ProudAddLine' and (lines[m[2]+1] or ''):find('const delay = baseDelayMs * 2 ** (attempt - 1)',1,true) then added=true end; for _,vl in ipairs(d.virt_lines or {}) do if table.concat(vim.tbl_map(function(c) return c[1] end,vl)):find('await sleep(1000)',1,true) and vim.tbl_contains(vim.iter(vl):map(function(c) return type(c[2])=='table' and c[2][1] or c[2] end):totable(),'ProudDeleteLine') then deleted=true end end end; local ok=state.status=='ready' and vim.bo[buf].buftype=='' and vim.bo[buf].modifiable and vim.wo[win].number and (vim.wo[win].winbar or ''):find('retry.ts',1,true)~=nil and code:find('export interface RetryConfig',1,true)~=nil and not code:find('@@',1,true) and added and deleted; vim.api.nvim_echo({{('FILE_DIFF_OK='..tostring(ok))}},false,{})}
send "\r"
wait_for {FILE_DIFF_OK=true} "full file diff text and palette"
sleep 1
send ":qa!\r"
expect eof
