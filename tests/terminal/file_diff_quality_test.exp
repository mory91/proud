set timeout 10

proc fail {message} {
  puts stderr "\nTERMINAL FILE DIFF FAIL: $message"
  catch {send ":qa!\r"}
  exit 1
}

proc wait_for {pattern label} {
  expect {
    -re $pattern {
      return
    }
    timeout {
      fail "timed out waiting for $label"
    }
    eof {
      fail "Neovim exited while waiting for $label"
    }
  }
}

log_user 1
spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && ./scripts/run_proud_test_nvim.sh"
stty rows 40 columns 160
wait_for {#482 diff.*single} "single file diff workspace"
send {:lua local session=require('proud.session'); local state=session.current and session.current.state; local workspace=state and state.workspace; local function text(name) local pane=workspace and workspace.panes[name]; return pane and table.concat(vim.api.nvim_buf_get_lines(pane.buffer,0,-1,false),'\n') or '' end; local function has_hl(name, needle, group) local pane=workspace and workspace.panes[name]; if not pane then return false end; local lines=vim.api.nvim_buf_get_lines(pane.buffer,0,-1,false); local ns=vim.api.nvim_get_namespaces().proud; for row,line in ipairs(lines) do local col=line:find(needle,1,true); if col then col=col-1; for _,mark in ipairs(vim.api.nvim_buf_get_extmarks(pane.buffer,ns,0,-1,{details=true})) do local detail=mark[4]; if mark[2]==row-1 and detail and detail.hl_group==group and (detail.start_col or 0)<=col and (detail.end_col or #line)>col then return true end end end end; return false end; local code=text('code'); local code_pane=workspace and workspace.panes.code; local ok=session.current.feature=='single_diff_threads' and workspace and #workspace.order==3 and code_pane and vim.api.nvim_buf_line_count(code_pane.buffer)>=27 and vim.wo[code_pane.window].wrap==false and code:find('export interface RetryConfig',1,true) and code:find('throw new Error("retry exhausted")',1,true) and code:find('for (let attempt = 0; attempt < config.retry.maxAttempts; attempt += 1)',1,true) and code:find('await sleep(1000)',1,true) and code:find('const delay = baseDelayMs * 2 ** (attempt - 1)',1,true) and not code:find('OLD  ',1,true) and not code:find('NEW  ',1,true) and not code:find('@@',1,true) and has_hl('code','await sleep(1000)','ProudDelete') and has_hl('code','const delay = baseDelayMs * 2 ** (attempt - 1)','ProudAdd') and not has_hl('code','import { sleep }','ProudDelete') and not has_hl('code','import { sleep }','ProudAdd'); vim.api.nvim_echo({{('FILE_DIFF_OK='..tostring(ok))}},false,{})}
send "\r"
wait_for {FILE_DIFF_OK=true} "full file diff text and palette"
sleep 1
send ":qa!\r"
expect eof
