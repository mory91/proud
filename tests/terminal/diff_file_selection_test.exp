set timeout 10

proc fail {message} {
  puts stderr "\nTERMINAL DIFF FILE SELECT FAIL: $message"
  catch {send ":qa!\r"}
  exit 1
}

proc wait_for {pattern label} {
  expect {
    -re $pattern {
      return
    }
    timeout {
      fail "timed out waiting for $label"
    }
    eof {
      fail "Neovim exited while waiting for $label"
    }
  }
}

log_user 1
spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && ./scripts/run_proud_test_nvim.sh"
stty rows 40 columns 160
wait_for {#482 diff.*single} "single file diff workspace"
send "\]f"
send "\x0c"
send {:lua local s=require('proud.session').current.state; local pane=s.workspace.panes.code; local code=table.concat(vim.api.nvim_buf_get_lines(pane.buffer,0,-1,false),'\n'); local ok=s.file_cursor==2 and (vim.wo[pane.window].winbar or ''):find('packages/runner/src/config.ts',1,true)~=nil and code:find('export type RunnerConfig',1,true)~=nil and code:find('retry:',1,true)~=nil; vim.api.nvim_echo({{('FILE_SWITCH_OK='..tostring(ok))}},false,{})}
send "\r"
wait_for {FILE_SWITCH_OK=true} "]f switches to the next diff file"
sleep 1
send ":qa!\r"
expect eof
