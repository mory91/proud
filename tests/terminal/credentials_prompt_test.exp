set timeout 10

proc fail {message} {
  puts stderr "\nCREDENTIALS TERMINAL FAIL: $message"
  catch {send ":qa!\r"}
  exit 1
}

log_user 1
spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && PROUD_START=credentials-e2e ./scripts/run_proud_test_nvim.sh"
stty rows 30 columns 100

expect {
  -re {CREDENTIALS_MODAL_CENTERED} {}
  timeout { fail "timed out waiting for centered credential modal" }
  eof { fail "Neovim exited before credential modal" }
}
expect {
  -re {Token} {}
  timeout { fail "timed out waiting for in-page token input" }
  eof { fail "Neovim exited before in-page token input" }
}
expect {
  -re {type the token in the page below} {}
  timeout { fail "credential page did not explain in-page token entry" }
  eof { fail "Neovim exited before credential instructions" }
}
send "github_pat_bad"
expect {
  -re {\*{8}} {}
  timeout { fail "in-page token input was not visibly masked" }
  eof { fail "Neovim exited while masking token input" }
}
send "\r"
expect {
  -re {HTTP 401: Token rejected} {}
  timeout { fail "invalid token error was not shown in the modal" }
  eof { fail "Neovim exited before invalid token error" }
}
send "github_pat_terminal"
expect {
  -re {\*{8}} {}
  timeout { fail "replacement token input was not visibly masked" }
  eof { fail "Neovim exited while masking replacement input" }
}
send "\r"
expect {
  -re {CREDENTIALS_TERMINAL_OK} {}
  timeout { fail "timed out waiting for credential validation" }
  eof { fail "Neovim exited before credential validation" }
}
send ":qa!\r"
expect eof

spawn -noecho /bin/zsh -lc "cd '$env(PROUD_ROOT)' && PROUD_START=credentials-reuse-e2e ./scripts/run_proud_test_nvim.sh"
stty rows 30 columns 100
expect {
  -re {CREDENTIALS_REUSE_OK} {}
  timeout { fail "saved credential was not reused on a later launch" }
  eof { fail "Neovim exited during credential reuse check" }
}
send ":qa!\r"
expect eof
